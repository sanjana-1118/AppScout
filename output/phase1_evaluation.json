  "limitations_analysis": {
    "observed_limitations": [
      "Category is not cleanly provided in JSON-LD (Schema.org applicationCategory returns generic 'DeveloperApplication'), requiring DOM anchor and URL parsing.",
      "Developer brand string occasionally includes promotional marketing copy (e.g. PageFly's brand includes tagline).",
      "Console output on Windows shells requires ASCII/replace handling due to special Unicode glyphs (e.g. ✦ in app titles).",
      "Human-verified ground truth is currently populated for only 1 app (Judge.me); remaining 3 apps rely on automated sanity validation."
    ],
    "potential_future_risks": [
      "Lack of multi-page crawling: App listings spanning paginated reviews or secondary pricing tabs are not yet collected.",
      "Anti-bot & rate-limiting: Bulk crawling at scale may encounter Cloudflare challenges or 429s without rate-throttling/session control.",
      "Shopify DOM changes: Structural changes to category links would trigger fallback slug derivation rather than primary anchor text.",
      "Single synchronous execution: No queueing, concurrency, or persistent relational storage."
    ]
  },
